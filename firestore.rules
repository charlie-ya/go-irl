rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Players collection
    match /players/{userId} {
      allow read: if true; // Anyone can read player profiles

      // CREATE: Can only create your own profile, starting as 'Lowly Vassal'
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.rank == 'Lowly Vassal';

      // UPDATE (own profile): Full update, but rank is server-only
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.rank == resource.data.rank;

      // UPDATE (other player - offer/trade only): Only balance & totalClaims may change
      // This allows the seller's transaction to credit/debit the buyer's coins.
      allow update: if request.auth != null
                    && request.auth.uid != userId
                    && request.resource.data.rank == resource.data.rank
                    && request.resource.data.explorerName == resource.data.explorerName
                    && request.resource.data.color == resource.data.color
                    && request.resource.data.id == resource.data.id;
    }
    
    // Tiles collection - authenticated users can claim tiles
    match /tiles/{tileId} {
      allow read: if true; // Anyone can read tiles
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid; // Authenticated users can claim
      allow update, delete: if request.auth != null && 
                               resource.data.ownerId == request.auth.uid; // Only owner can modify
    }
    
    // Offers collection - users can make offers on tiles
    match /offers/{offerId} {
      allow read: if request.auth != null; // Authenticated users can read offers
      allow create: if request.auth != null 
                    && request.resource.data.buyerId == request.auth.uid; // Can only create offers as yourself
      allow update: if request.auth != null 
                    && (resource.data.sellerId == request.auth.uid 
                        || resource.data.buyerId == request.auth.uid); // Seller or buyer can update
      allow delete: if request.auth != null 
                    && resource.data.buyerId == request.auth.uid; // Buyer can cancel their offer
    }
    
    // Captured Territories collection - read-only for all, system creates
    match /captured/{territoryId} {
      allow read: if true; // Anyone can read territories
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Exclusion Zones collection
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK or Cloud Functions can write exclusion zones
    }

    // Scanned Regions tracking
    match /scannedRegions/{regionId} {
      allow read: if true;
      allow write: if false;
    }

    // Leaderboard cache (written by Cloud Functions, readable by all)
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions (admin SDK) can write
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.refereeId == request.auth.uid 
                    && request.resource.data.referrerId != request.auth.uid; // Prevent self-referral
      allow update: if request.auth != null
                    && request.resource.data.refereeId == resource.data.refereeId
                    && request.resource.data.referrerId == resource.data.referrerId; // Prevent changing existing links
    }

    // Promotion Ceremonies collection
    match /ceremonies/{gridKey} {
      allow read: if request.auth != null;

      // Only the ceremony owner can create (must set themselves as ownerId)
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'active';

      // Any authenticated user can update (for affirmations via arrayUnion)
      // But status cannot be changed client-side (only Cloud Function can complete)
      allow update: if request.auth != null
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.ownerId == resource.data.ownerId;

      // Only Cloud Functions (admin SDK) can delete
      allow delete: if false;
    }
  }
}
